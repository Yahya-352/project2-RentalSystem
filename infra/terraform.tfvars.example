# Copy to terraform.tfvars and fill in. terraform.tfvars is ignored by Git.

aws_region    = "eu-central-1"
instance_type = "t3.medium" # t3.micro is free tier but very tight for six services plus Kafka

smtp_username         = "your-mailtrap-username"
smtp_password         = "your-mailtrap-password"
admin_username        = "admin@rental.com"
admin_password        = "change-me"
seed_password         = "change-me"
stripe_secret_key     = "sk_test_..."
stripe_webhook_secret = "whsec_..."

# Optional
# alert_email = "you@example.com"
# frontend_url = ""   # defaults to the CloudFront URL
